# 複製成 .env 再填值。.env 不進版控。
# 正式環境不用 .env，同樣的名稱設定在主機的環境變數裡。值的前後不要加引號。

# PostgreSQL 的連線字串。本機用 tools/local_db.sh start 啟動資料庫，它會印出這一行。
DATABASE_URL=postgresql://postgres@localhost:5442/minyou_t_forum_dev

# 允許呼叫這個 backend 的 web 來源，逗號分隔。要含 http:// 或 https://，結尾不要有斜線，
# 也不要帶路徑：瀏覽器送來的 Origin 只有網域與 port，多寫就對不上。
# web 放在 GitHub Pages 的話是 https://<帳號>.github.io，後面的 /<repo>/ 不要寫。
ALLOWED_ORIGINS=http://localhost:8180

# Google 登入用的 OAuth 用戶端 ID。到 Google Cloud Console 建立，類型選「網頁應用程式」，
# 並把 web 的來源（跟上面 ALLOWED_ORIGINS 一樣的那幾個）加進「已授權的 JavaScript 來源」。
# web 的 js/config.js 要填同一個值。
GOOGLE_CLIENT_ID=

# 第一位管理員的 Google 帳號。用這個帳號登入不用審核，直接是管理員；其他人的角色之後在後台設定。
FIRST_ADMIN_EMAIL=

# 社區文檔的來源，兩種擇一。
# 一、本機資料夾（開發用）：放進去的檔案會出現在「社區文檔」頁籤。
#     可以寫絕對路徑，或相對於這個專案資料夾的路徑。資料夾不存在時會自動建立。
DOCUMENTS_DIR=local_documents
# 二、Google Drive 的資料夾（正式環境用）：把上面的 DOCUMENTS_DIR 留空，改填下面兩個。
#     SERVICE_ACCOUNT_JSON 是服務帳號金鑰檔的完整內容（一整段 JSON，貼成一行）。
#     DRIVE_FOLDER_ID 是資料夾網址 https://drive.google.com/drive/folders/<這一段>。
#     資料夾要先分享給服務帳號的 email（權限選「檢視者」）。
SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=

# 登入憑證連續幾天沒用就失效，不填就是 90。
SESSION_IDLE_DAYS=

# 本機啟動用的 port，不填就是 5180。
PORT=
